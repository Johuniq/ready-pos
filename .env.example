# ReadyPOS Environment Configuration Template
#
# Copy this file to .env and fill in your actual credentials
# NEVER commit the .env file to version control
#
# See LICENSE-CREDENTIALS-SETUP.md for detailed setup instructions

# Polar.sh License Credentials
# Get these from: https://polar.sh (your organization settings)
READYPOS_POLAR_TOKEN=your_polar_token_here
READYPOS_POLAR_ORG_ID=your_organization_id_here

# WordPress Environment (optional)
# WP_ENV=development
# WP_DEBUG=true
